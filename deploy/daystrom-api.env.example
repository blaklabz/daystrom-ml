# Install as /etc/daystrom/daystrom-api.env, chmod 0600, owned by root.
# Generate a unique random token: openssl rand -hex 32
DAYSTROM_API_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# Must be a PostgreSQL role granted SELECT on node_metric_observations only.
# Do NOT reuse the collector's database credentials.
DAYSTROM_DATABASE_URL=postgresql+psycopg://daystrom_api_reader:REPLACE_WITH_PASSWORD@127.0.0.1:5432/REPLACE_WITH_DATABASE
